# Window
window-save-state = never
window-width = 206
window-height = 51

# Font and spacing
font-family="Maple-Mono-NF-CN"
font-size = 13
font-thicken = true
font-thicken-strength = 100
adjust-cell-height = 5

# Background and colors
background-opacity = 0.95
# background-blur = 20
background = #212734
foreground = #e6e6e6
bold-color = #f0f0f0
selection-background = #334e5e
selection-foreground = cell-foreground
palette = 0=#35424c
palette = 1=#b45648
palette = 2=#6caa71
palette = 3=#c4ac62
palette = 4=#6d96b4
palette = 5=#bd7bcd
palette = 6=#7ccbcd
palette = 7=#dee5eb
palette = 8=#465c6d
palette = 9=#df6c5a
palette = 10=#79be7e
palette = 11=#e5c872
palette = 12=#67b5ed
palette = 13=#d389e5
palette = 14=#84dde0
palette = 15=#e5eff5

# Cursor
cursor-style = bar
cursor-style-blink = false
adjust-cursor-thickness = 3
cursor-color = cell-foreground
custom-shader = ~/Library/Application Support/com.mitchellh.ghostty/cursor_warp.glsl

# Shell and scrolling
shell-integration-features = ssh-env,ssh-terminfo,no-cursor
mouse-scroll-multiplier = precision:1,discrete:1
