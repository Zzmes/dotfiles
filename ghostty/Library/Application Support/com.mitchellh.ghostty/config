font-family="Maple-Mono-NF-CN"
font-size = 13

background-opacity = 0.95
# background-blur = 20

# Colors copied from macOS Terminal: Clear Dark
background = #212734
foreground = #e6e6e6
bold-color = #f0f0f0
selection-background = #334e5e
selection-foreground = cell-foreground
palette = 0=#35424c
palette = 1=#b45648
palette = 2=#6caa71
palette = 3=#c4ac62
palette = 4=#6d96b4
palette = 5=#bd7bcd
palette = 6=#7ccbcd
palette = 7=#dee5eb
palette = 8=#465c6d
palette = 9=#df6c5a
palette = 10=#79be7e
palette = 11=#e5c872
palette = 12=#67b5ed
palette = 13=#d389e5
palette = 14=#84dde0
palette = 15=#e5eff5

shell-integration-features = ssh-env,ssh-terminfo

# Neovide-style cursor animation
# custom-shader = ~/Library/Application Support/com.mitchellh.ghostty/cursor_warp.glsl
adjust-cell-height = 3
cursor-color = cell-foreground

mouse-scroll-multiplier = precision:1,discrete:1
